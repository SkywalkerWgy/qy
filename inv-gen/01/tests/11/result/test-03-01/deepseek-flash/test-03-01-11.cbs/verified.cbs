#define MAX 100

/*@
    requires 0 < n <= MAX;
    requires \valid_read(w + (0 .. n - 1));
    requires \valid_read(v + (0 .. n - 1));
    requires \valid(taken + (0 .. n - 1));
    requires \forall integer i; 0 <= i < n ==> w[i] > 0 && v[i] >= 0;
    requires \forall integer i; 0 <= i < n - 1 ==> v[i] * w[i + 1] >= v[i + 1] * w[i];
    requires \separated(taken + (0 .. n - 1), w + (0 .. n - 1), v + (0 .. n - 1));
    requires 0 <= W;
    assigns taken[0 .. n - 1];
    ensures \forall integer i; 0 <= i < n ==> 0 <= taken[i] <= w[i];
*/
_Safe void fractional_knapsack(int w[_Nonnull ], int v[_Nonnull ], int n, int W, int taken[_Nonnull ]) {
    int i;
    int rem = W;

        // Loop A
/*@
        loop invariant i_0: 0 <= i <= n;

        loop invariant i_1: 0 <= rem <= W;

        loop invariant i_2: \forall integer j; 0 <= j < i ==> 0 <= taken[j] <= w[j];


        loop assigns i, rem, taken[0 .. n - 1];
    */
    for (i = 0; i < n; i++) {
        if (rem == 0) {
            taken[i] = 0;
        } else if (rem >= w[i]) {
            taken[i] = w[i];
            rem = rem - w[i];
        } else {
            taken[i] = rem;
            rem = 0;
        }
    }
}
