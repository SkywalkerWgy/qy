#define BASE 10

/*@
  predicate sorted(int* a, integer lo, integer hi) =
    \forall integer i, j; lo <= i < j < hi ==> a[i] <= a[j];
*/

/*@
  requires 1 <= n;
  requires \valid(a + (0 .. n-1));
  requires \valid(tmp + (0 .. n-1));
  requires \separated(a + (0 .. n-1), tmp + (0 .. n-1));
  requires \forall integer i; 0 <= i < n ==> 0 <= a[i] < BASE;
  assigns a[0 .. n-1], tmp[0 .. n-1];
  ensures sorted(a, 0, n);
  ensures \forall integer i; 0 <= i < n ==> 0 <= a[i] < BASE;
*/
_Safe void radix_sort(int a[_Nonnull], int n, int tmp[_Nonnull]) {
    int count[BASE];
    int exp = 1;
    int i, v, pos, j, pos_start;

        // Loop A
/*@
        loop invariant i_0: 0 <= v && v <= BASE;

        loop invariant i_1: \forall integer k; 0 <= k && k < v ==> count[k] == 0;


        loop assigns v, count[0 .. BASE-1];
    */
    for (v = 0; v < BASE; v++) {
        count[v] = 0;
    }

        // Loop B
/*@
        loop invariant i_6: 0 <= i <= n;

        loop invariant i_7: \forall integer d; 0 <= d < BASE ==> 0 <= count[d] <= i;


        loop assigns i, count[0 .. BASE-1];
    */
    for (i = 0; i < n; i++) {
        int d = (a[i] / exp) % BASE;
        count[d] = count[d] + 1;
    }

    pos = 0;

        // Loop C
/*@
        loop invariant i_12: 0 <= v <= BASE;

        loop invariant i_13: 0 <= pos <= n;

        loop invariant i_14: \sum integer d;

        loop invariant i_15: pos == \sum integer d;

        loop invariant i_16: \forall integer k; 0 <= k < pos ==> 0 <= tmp[k] < v;

        loop invariant i_17: sorted(tmp, 0, pos);

        loop invariant i_18: \forall integer d; 0 <= d < v ==> \sum integer k;


        loop assigns v, j, pos, pos_start, tmp[0 .. n-1];
    */
    for (v = 0; v < BASE; v++) {
        pos_start = pos;

                // Loop D
/*@
            loop invariant i_19: 0 <= j <= count[v];

            loop invariant i_20: pos == pos_start + j;

            loop invariant i_21: pos_start <= pos <= n;

            loop invariant i_22: pos_start == \sum integer d;

            loop invariant i_23: pos_start + count[v] <= n;

            loop invariant i_24: \forall integer k; pos_start <= k < pos ==> tmp[k] == v;

            loop invariant i_25: \forall integer k; 0 <= k < pos_start ==> 0 <= tmp[k] < v;

            loop invariant i_26: \forall integer k; 0 <= k < pos ==> 0 <= tmp[k] <= v;

            loop invariant i_27: sorted(tmp, 0, pos);

            loop invariant i_28: \forall integer d; 0 <= d < v ==> count[d] == \sum integer k;


            loop assigns j, pos, tmp[0 .. n-1];
        */
        for (j = 0; j < count[v] && pos < n; j++) {
            tmp[pos] = v;
            pos = pos + 1;
        }
    }

        // Loop E
/*@
        loop invariant i_9: 0 <= pos <= n;

        loop invariant i_10: sorted(tmp, 0, pos);

        loop invariant i_11: \forall integer k; 0 <= k < pos ==> 0 <= tmp[k] < BASE;


        loop assigns pos, tmp[0 .. n-1];
    */
    for (; pos < n; pos++) {
        tmp[pos] = BASE - 1;
    }

        // Loop F
/*@
        loop invariant i_2: 0 <= i <= n;

        loop invariant i_3: \forall integer k; 0 <= k < i ==> a[k] == tmp[k];

        loop invariant i_4: sorted(tmp, 0, n);

        loop invariant i_5: \forall integer k; 0 <= k < n ==> 0 <= tmp[k] < BASE;


        loop assigns i, a[0 .. n-1];
    */
    for (i = 0; i < n; i++) {
        a[i] = tmp[i];
    }
}
