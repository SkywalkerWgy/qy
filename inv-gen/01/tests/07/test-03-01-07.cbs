/*@
  predicate sorted_range{Here}(int* a, integer start, integer end) =
    \forall integer k1, k2;
    start <= k1 <= k2 < end ==> a[k1] <= a[k2];
*/

/*@
    requires \valid(x) && \valid(y);
    assigns *x, *y;
    ensures *x == \old(*y) && *y == \old(*x);
*/
_Safe void swap(int *_Borrow _Nonnull x, int *_Borrow _Nonnull y) {
    int tmp = *x;
    *x = *y;
    *y = tmp;
}

/*@
  requires lo <= hi;
  requires \valid(a + (lo .. hi));
  assigns a[lo..hi];
  ensures sorted_range(a, lo, hi + 1);
*/
_Safe void bubble_sort(int*_Nonnull a, int lo, int hi) {
    int up = lo + 1;
    int down;

    /*@
        loop assigns down, up, a[lo..hi];
    */
    for (; up <= hi; up++) {
        down = up;
        /*@
          loop assigns down, a[lo..hi];
        */
        while (lo < down && a[down] < a[down - 1]) {
            int tmp = a[down];
            a[down] = a[down - 1];
            a[down - 1] = tmp;
            down = down - 1;
        }
    }
}

/*@
requires lo <= hi;
requires \valid(a + (lo .. hi));
assigns a[lo..hi];
ensures lo <= \result <= hi;
ensures \forall integer i; lo <= i <= \result ==> a[i] <= a[\result];
ensures \forall integer i; \result <= i <= hi ==> a[i] >= a[\result];
ensures lo <= \result <= hi;
*/
_Safe int partition(int*_Nonnull a, int lo, int hi) {
    int pivot = a[hi];
    int i = lo - 1;
    int j;

    /*@
      loop assigns a[lo..hi], i, j;
    */
    for (j = lo; j < hi; j++) {
        if (a[j] <= pivot) {
            i++;
            int tmp = a[i];
            a[i] = a[j];
            a[j] = tmp;
        }
    }
    int partition_tmp = a[i + 1];
    a[i + 1] = a[hi];
    a[hi] = partition_tmp;
    return i + 1;
}

/*@
    requires \valid(a + (l..r));
    requires l <= k <= r;
    decreases r - l;
    assigns a[l..r];
*/
_Safe int deterministic_select_rec(int*_Nonnull a, int l, int r, int k) {
    if (l == r) return a[l];

    int n = r - l + 1;
    int i, m;

    if (n <= 5) {
        bubble_sort(a, l, r);
        return a[k];
    }

    m = 0;
    /*@
        loop assigns i, m, a[l..r];
    */
    for (i = l; i + 4 <= r; i += 5) {
        bubble_sort(a, i, i + 4);
        int median_tmp = a[l + m];
        a[l + m] = a[i + 2];
        a[i + 2] = median_tmp;
        m = m + 1;
    }

    int med = deterministic_select_rec(a, l, l + m - 1, l + m / 2);

    /*@
        loop assigns i;
    */
    for (i = l; i <= r; i++) {
        if (a[i] == med) break;
    }
    if (i == r+1) return -1;
    int pivot_tmp = a[i];
    a[i] = a[r];
    a[r] = pivot_tmp;

    int p = partition(a, l, r);

    if (k < p) return deterministic_select_rec(a, l, p - 1, k);
    if (k > p) return deterministic_select_rec(a, p + 1, r, k);
    return a[k];
}
