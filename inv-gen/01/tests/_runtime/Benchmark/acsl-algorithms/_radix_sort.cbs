#define BASE 10

/*@
  predicate sorted(int* a, integer lo, integer hi) =
    \forall integer i, j; lo <= i < j < hi ==> a[i] <= a[j];
*/

/*@
  requires 1 <= n;
  requires \valid(a + (0 .. n-1));
  requires \valid(tmp + (0 .. n-1));
  requires \separated(a + (0 .. n-1), tmp + (0 .. n-1));
  requires \forall integer i; 0 <= i < n ==> 0 <= a[i] < BASE;
  assigns a[0 .. n-1], tmp[0 .. n-1];
  ensures sorted(a, 0, n);
  ensures \forall integer i; 0 <= i < n ==> 0 <= a[i] < BASE;
*/
_Safe void radix_sort(int a[_Nonnull], int n, int tmp[_Nonnull]) {
    int count[BASE];
    int exp = 1;
    int i, v, pos, j, pos_start;

    /*@
        loop assigns v, count[0 .. BASE-1];
    */
    for (v = 0; v < BASE; v++) {
        count[v] = 0;
    }

    /*@
        loop assigns i, count[0 .. BASE-1];
    */
    for (i = 0; i < n; i++) {
        int d = (a[i] / exp) % BASE;
        count[d] = count[d] + 1;
    }

    pos = 0;

    /*@
        loop assigns v, j, pos, pos_start, tmp[0 .. n-1];
    */
    for (v = 0; v < BASE; v++) {
        pos_start = pos;

        /*@
            loop assigns j, pos, tmp[0 .. n-1];
        */
        for (j = 0; j < count[v] && pos < n; j++) {
            tmp[pos] = v;
            pos = pos + 1;
        }
    }

    /*@
        loop assigns pos, tmp[0 .. n-1];
    */
    for (; pos < n; pos++) {
        tmp[pos] = BASE - 1;
    }

    /*@
        loop assigns i, a[0 .. n-1];
    */
    for (i = 0; i < n; i++) {
        a[i] = tmp[i];
    }
}
