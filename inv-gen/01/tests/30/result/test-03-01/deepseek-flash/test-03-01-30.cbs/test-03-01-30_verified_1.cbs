/*@
  predicate sorted{Here}(int* a, integer start_index, integer end_index) =
    \forall integer k1, k2;
    start_index <= k1 <= k2 <= end_index ==> a[k1] <= a[k2];
*/

/*@
  requires \valid(x) && \valid(y);
  assigns *x, *y;
  ensures *x == \old(*y) && *y == \old(*x);
*/
_Safe void swap(int *_Borrow _Nonnull x, int *_Borrow _Nonnull y) {
  int tmp = *x;
  *x = *y;
  *y = tmp;
}

/*@
requires lo <= hi;
requires \valid(a + (lo .. hi));
assigns a[lo..hi];
ensures lo <= \result <= hi;
ensures \forall integer i; lo <= i <= \result ==> a[i] <= a[\result];
ensures \forall integer i; \result <= i <= hi ==> a[i] >= a[\result];
ensures lo <= \result <= hi;
*/
_Safe int _quick_sort(int*_Nonnull a, int lo, int hi) {
  int pivot = a[hi];
  int i = lo - 1;
  int j;

  // Loop A
/*@
    loop invariant i_0: lo - 1 <= i && i < j && j <= hi;

    loop invariant i_1: a[hi] == pivot;

    loop invariant i_2: \forall integer k; lo <= k && k <= i ==> a[k] <= pivot;

    loop invariant i_3: \forall integer k; i < k && k < j ==> a[k] > pivot;


    loop assigns a[lo..hi], i, j;
    loop variant hi - j;
  */
  for (j = lo; j < hi; j++) {
      if (a[j] <= pivot) {
          i++;
          int tmp = a[i];
          a[i] = a[j];
          a[j] = tmp;
      }
  }
  int tmp = a[i + 1];
  a[i + 1] = a[hi];
  a[hi] = tmp;
  return i + 1;
}

/*@
    requires \valid(t + (l..r));
    decreases r - l;
    assigns t[l..r];
 */
_Safe void quick_rec(int*_Nonnull t, int l, int r) {
    if (l >= r) return;
    int pivot = _quick_sort(t, l, r);
    quick_rec(t, l, pivot - 1);
    quick_rec(t, pivot + 1, r);

}

/*@ requires n > 0;
    requires \valid(t + (0..n-1));
    assigns t[0..n-1];
*/
_Safe void QuickSort(int*_Nonnull t, int n) {
    quick_rec(t, 0, n - 1);
}
