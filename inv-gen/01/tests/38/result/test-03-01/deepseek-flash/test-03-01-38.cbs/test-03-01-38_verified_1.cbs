/*@
    predicate connect(int** graph, integer i, integer j, integer n) =
        0 <= i < n && 0 <= j < n && ((i == j) || (graph[i][j] == 1) || (graph[j][i] == 1) || (\exists integer k; 0 <= k < n && connect(graph, i, k, n) && connect(graph, k, j, n)));
*/

/*@
    requires 0 <= start < n;
    requires \valid(graph + (0..(n)));
    requires \valid(graph[0..(n)] + (0..(n)));
    requires \valid(dist + (0..(n)));
    requires \valid(visited + (0..(n)));
    requires \valid(queue + (0..(n)));
    requires \forall integer i, j; 0 <= i <= n && 0 <= j <= n && i != j ==> \separated(&graph[i] + (0..(n)), &graph[j] + (0..(n)), &dist[0..(n)], &visited[0..(n)], &queue[0..(n)]);
    requires \separated(&dist[0..(n)], &visited[0..(n)], &queue[0..(n)]);
    requires \forall integer j; 0 <= j <= n && j != start ==> visited[j] == 0 && dist[j] == -1;
    requires visited[start] == 1 && dist[start] == 0;
    requires queue[0] == start;
    requires \forall integer i, j; 0 <= i <= n ==> graph[i][i] == 1;
    requires \forall integer i, j; 0 <= i <= n && 0 <= j <= n ==> graph[i][j] == graph[j][i];
    requires \forall integer i, j; 0 <= i <= n && 0 <= j <= n ==> (graph[i][j] == 0 || graph[i][j] == 1);
    ensures e_1: \forall integer i; (0 <= i < n && visited[i] == 1) ==> connect(graph, i, start, n);
    assigns dist[0..(n)], visited[0..(n)], queue[0..(n)];
*/
_Safe void _bfs(int*_Nonnull*_Nonnull graph, int*_Nonnull dist, int*_Nonnull visited, int*_Nonnull queue, int start, int n) {
    int rear = 0;
    int front = 0;
    int node = start;
        // Loop A
/*@
        loop invariant i_0: 0 <= front && front <= n;

        loop invariant i_1: 0 <= rear && rear < n;

        loop invariant i_2: front <= rear + 1;

        loop invariant i_3: 0 <= node && node < n;

        loop invariant i_4: visited[start] == 1;

        loop invariant i_5: dist[start] == 0;

        loop invariant i_6: queue[0] == start;

        loop invariant i_7: visited[node] == 1;

        loop invariant i_8: front <= rear ==> node == queue[front];

        loop invariant i_9: \forall integer i; 0 <= i && i <= rear ==> 0 <= queue[i] && queue[i] < n;

        loop invariant i_10: \forall integer i, j; 0 <= i && i < j && j <= rear ==> queue[i] != queue[j];

        loop invariant i_11: \forall integer i; 0 <= i && i < n ==> (visited[i] == 1 <==> (\exists integer j; 0 <= j && j <= rear && queue[j] == i));

        loop invariant i_12: \forall integer i; 0 <= i && i < n && visited[i] == 1 ==> dist[i] >= 0;

        loop invariant i_13: \forall integer i; 0 <= i && i < n && visited[i] == 0 ==> dist[i] == -1;

        loop invariant i_14: \forall integer i; 0 <= i && i < n && visited[i] == 1 ==> connect(graph, i, start, n);


        loop assigns front;
        loop assigns rear;
        loop assigns node;
        loop assigns queue[0..(n)];
        loop assigns dist[0..(n)];
        loop assigns visited[0..(n)];
    */
    while (front <= rear && front < n && rear < n) {
                // Loop B
/*@
            loop invariant i_15: 0 <= i && i <= n;

            loop invariant i_16: 0 <= front && front <= n;

            loop invariant i_17: 0 <= rear && rear < n;

            loop invariant i_18: front <= rear + 1;

            loop invariant i_19: 0 <= node && node < n;

            loop invariant i_20: visited[start] == 1;

            loop invariant i_21: dist[start] == 0;

            loop invariant i_22: queue[0] == start;

            loop invariant i_23: visited[node] == 1;

            loop invariant i_24: front <= rear ==> node == queue[front];

            loop invariant i_25: \forall integer k; 0 <= k && k <= rear ==> 0 <= queue[k] && queue[k] < n;

            loop invariant i_26: \forall integer k, j; 0 <= k && k < j && j <= rear ==> queue[k] != queue[j];

            loop invariant i_27: \forall integer k; 0 <= k && k < n ==> (visited[k] == 1 <==> (\exists integer j; 0 <= j && j <= rear && queue[j] == k));

            loop invariant i_28: \forall integer k; 0 <= k && k < n && visited[k] == 1 ==> dist[k] >= 0;

            loop invariant i_29: \forall integer k; 0 <= k && k < n && visited[k] == 0 ==> dist[k] == -1;

            loop invariant i_30: \forall integer k; 0 <= k && k < n && visited[k] == 1 ==> connect(graph, k, start, n);


            loop assigns rear;
            loop assigns queue[0..(n)];
            loop assigns dist[0..(n)];
            loop assigns visited[0..(n)];
            loop assigns i;
        */
        for (int i = 0; i < n; i++) {
            if (graph[node][i] == 1 && visited[i] == 0 && rear < n) {
                rear++;
                queue[rear] = i;
                visited[i] = 1;
                dist[i] = dist[node] + 1;
            }
        }
        front += 1;
        if(front <= rear){
            node = queue[front];
        }
        else{
            break;
        }
    }
}