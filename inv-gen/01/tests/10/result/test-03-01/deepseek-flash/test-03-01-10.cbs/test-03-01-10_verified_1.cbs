/*@ axiomatic PowMod {
    logic integer pow_mod(integer x, integer n, integer m);

    axiom pow_0: \forall integer x, m; m > 0 ==> pow_mod(x, 0, m) == 1 ;

    axiom pow_range: \forall integer x, n, m;
        m > 0 && x >= 0 && n >= 0 ==> 0 <= pow_mod(x, n, m) < m;

    axiom pow_base_mod: \forall integer x, n, m;
        m > 0 ==> pow_mod(x, n, m) == pow_mod(x % m, n, m);

    axiom pow_succ: \forall integer x, n, m;
        m > 0 && n > 0 ==>
        pow_mod(x, n, m) == ((x % m) * pow_mod(x, n - 1, m)) % m;
    }
 */

/*@
    lemma pow_loop_even: \forall integer r, b, e, m;
        m > 0 && e > 0 && e % 2 == 0 ==>
        (r * pow_mod(b, e, m)) % m ==
        (r * pow_mod((b * b) % m, e / 2, m)) % m;

    lemma pow_loop_odd: \forall integer r, b, e, m;
        m > 0 && e % 2 == 1 ==>
        (r * pow_mod(b, e, m)) % m ==
        ((r * b % m) * pow_mod((b * b) % m, e / 2, m)) % m;
 */

/*@
    requires m > 0;
    requires x >= 0;
    requires n >= 0;
    ensures 0 <= \result < m;
    ensures \result == pow_mod(x, n, m);
*/
_Safe int fast_pow_mod(int x, int n, int m) {
    int res = 1 % m;
    int base = x % m;
    int exp = n;

        // Loop A
/*@
        loop invariant i_0: m > 0;

        loop invariant i_1: x >= 0 && n >= 0;

        loop invariant i_2: 0 <= res && res < m;

        loop invariant i_3: 0 <= base && base < m;

        loop invariant i_4: 0 <= exp && exp <= n;

        loop invariant i_5: (res * pow_mod(base, exp, m)) % m == pow_mod(x, n, m) % m;


        loop assigns res, base, exp;
    */
    while (exp > 0) {
        if (exp % 2 == 1) {
            res = (res * base) % m;
            base = (base * base) % m;
            exp = exp / 2;
        }
        else {
            base = (base * base) % m;
            exp = exp / 2;
        }
    }
    return res;
}
