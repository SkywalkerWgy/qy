/*@
    requires \valid(x) && \valid(y);
    assigns *x, *y;
    ensures *x == \old(*y) && *y == \old(*x);
*/
_Safe void swap(int *_Borrow _Nonnull x, int *_Borrow _Nonnull y) {
    int tmp = *x;
    *x = *y;
    *y = tmp;
}

/*@
requires lo <= hi;
requires \valid(a + (lo .. hi));
assigns a[lo..hi];
ensures lo <= \result <= hi;
ensures \forall integer i; lo <= i <= \result ==> a[i] <= a[\result];
ensures \forall integer i; \result <= i <= hi ==> a[i] >= a[\result];
ensures lo <= \result <= hi;
*/
_Safe int partition(int*_Nonnull a, int lo, int hi) {
    int pivot = a[hi];
    int i = lo - 1;
    int j;

    /*@
      loop assigns a[lo..hi], i, j;
    */
    for (j = lo; j < hi; j++) {
        if (a[j] <= pivot) {
            i++;
            int tmp = a[i];
            a[i] = a[j];
            a[j] = tmp;
        }
    }
    int tmp = a[i + 1];
    a[i + 1] = a[hi];
    a[hi] = tmp;
    return i + 1;
}

/*@
    requires \valid(a + (l..r));
    requires l <= k <= r;
    decreases r - l;
    assigns a[l..r];
*/
_Safe void randomized_select_rec(int*_Nonnull a, int l, int r, int k) {
    if (l == r) return;

    int p = partition(a, l, r);

    if (k < p) {
        randomized_select_rec(a, l, p - 1, k);
    } else if (k > p) {
        randomized_select_rec(a, p + 1, r, k);
    }
}

/*@
    requires 0 <= k < length;
    requires \valid(a + (0..length-1));
    assigns a[0..length-1];
*/
_Safe void randomized_select(int*_Nonnull a, int length, int k) {
    randomized_select_rec(a, 0, length - 1, k);
}
