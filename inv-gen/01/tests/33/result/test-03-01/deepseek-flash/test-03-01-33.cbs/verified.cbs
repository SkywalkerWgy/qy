/*@
  predicate sorted(int *t, integer lo, integer hi) =
    \forall integer i, j; lo <= i <= j < hi ==> t[i] <= t[j];
*/

/*@
    requires \valid(x) && \valid(y);
    assigns *x, *y;
    ensures *x == \old(*y) && *y == \old(*x);
*/
_Safe void swap(int *_Borrow _Nonnull x, int *_Borrow _Nonnull y) {
    int tmp = *x;
    *x = *y;
    *y = tmp;
}

/*@ requires \valid(arr+(0..(n - 1)));
    requires n > 0;
    ensures sorted(arr, 0, n);
    assigns arr[0..(n - 1)];
*/
_Safe void _select_sort(int*_Nonnull arr, int n)
{
        // Loop A
/*@
        loop invariant i_0: 0 <= i <= n - 1;

        loop invariant i_1: sorted(arr, 0, i);

        loop invariant i_2: \forall integer k, l; 0 <= k < i && i <= l < n ==> arr[k] <= arr[l];


        loop assigns i, arr[0..(n - 1)];
    */
    for (int i = 0; i < n - 1; i++)
    {
        int min = i;
                // Loop B
/*@
            loop invariant i_3: i <= j <= n;

            loop invariant i_4: i <= min < n;

            loop invariant i_5: \forall integer k; i <= k < j ==> arr[min] <= arr[k];


            loop assigns j, min;
        */
        for (int j = i; j < n; j++){
            if (arr[j] < arr[min]){
                min = j;
            }
        }
        int tmp = arr[min];
        arr[min] = arr[i];
        arr[i] = tmp;
    }
}
