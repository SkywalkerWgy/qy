/*@
    requires 0 < n;
    requires \valid(parent + (0..n-1));
    requires \valid(rank + (0..n-1));
    requires \separated(parent+(0..n-1), rank+(0..n-1));
    assigns parent[0..n-1], rank[0..n-1];
    ensures \forall integer i; 0 <= i < n ==> parent[i] == i;
    ensures \forall integer i; 0 <= i < n ==> rank[i] == 0;
*/
_Safe void uf_init(int parent[_Nonnull ], int rank[_Nonnull ], int n) {
    int i;
    /*@
        loop assigns i, parent[0..n-1], rank[0..n-1];
    */
    for (i = 0; i < n; i++) {
        parent[i] = i;
        rank[i] = 0;
    }
}

/*@
    requires \valid(parent + (0..n-1));
    requires 0 <= x < n;
    requires \forall integer i; 0 <= i < n ==> 0 <= parent[i] < n;
    assigns parent[0..n-1];
    ensures 0 <= \result < n;
    ensures parent[\result] == \result;
    ensures \forall integer i; 0 <= i < n ==> 0 <= parent[i] < n;
*/
_Safe int uf_find(int parent[_Nonnull ], int n, int x) {
    /*@
        loop assigns parent[0..n-1], x;
    */
    while (parent[x] != x) {
        parent[x] = parent[parent[x]];
        x = parent[x];
    }
    return x;
}

/*@
    requires \valid(parent + (0..n-1));
    requires \valid(rank + (0..n-1));
    requires 0 <= x < n && 0 <= y < n;
    requires \forall integer i; 0 <= i < n ==> 0 <= parent[i] < n;
    requires \forall integer i; 0 <= i < n ==> rank[i] >= 0;
    requires \separated(parent+(0..n-1), rank+(0..n-1));
    assigns parent[0..n-1], rank[0..n-1];
    ensures \forall integer i; 0 <= i < n ==> 0 <= parent[i] < n;
    ensures \forall integer i; 0 <= i < n ==> rank[i] >= 0;
*/
_Safe void uf_union(int parent[_Nonnull ], int rank[_Nonnull ], int n, int x, int y) {
    int rx = uf_find(parent, n, x);
    int ry = uf_find(parent, n, y);
    if (rx == ry) return;

    if (rank[rx] < rank[ry]) {
        parent[rx] = ry;
    } else if (rank[rx] > rank[ry]) {
        parent[ry] = rx;
    } else {
        parent[ry] = rx;
        rank[rx] = rank[rx] + 1;
    }
}
