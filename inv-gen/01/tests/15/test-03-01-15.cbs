#include <stdlib.h>

struct Node {
    char ch;
    int freq;
    struct Node *_Borrow _Nullable left;
    struct Node *_Borrow _Nullable right;
};

/*@
    predicate Sorted(struct Node **t, integer lo, integer hi) =
        \forall integer i, j; lo <= i <= j < hi ==> t[i]->freq <= t[j]->freq;
*/


/*@
    predicate is_first_second_min(struct Node *t[], int n, int i, int j) =
        0 <= i < n && 0 <= j < n && i != j && \forall integer k; 0 <= k < n ==> t[k]->freq >= t[i]->freq && t[k]->freq >= t[j]->freq;
*/

/*@
  requires freq > 0;
  assigns \nothing;
  ensures \result != \null;
  ensures \result->ch == ch;
  ensures \result->freq == freq;
  ensures \result->left == left && \result->right == right;
*/
_Safe struct Node *_Borrow _Nonnull newNode(
    char ch, int freq,
    struct Node *_Borrow _Nullable left,
    struct Node *_Borrow _Nullable right) {
    /* Raw allocation is the only unsafe boundary.  The returned node is
       intentionally retained for the lifetime of the constructed tree. */
    _Unsafe {
        struct Node *res = (struct Node *)malloc(sizeof(struct Node));
        if (res == NULL) abort();
        res->ch = ch;
        res->freq = freq;
        res->left = left;
        res->right = right;
        return (struct Node *_Borrow)res;
    }
}

/*@ requires \valid(t+(0..n-1));
    requires n > 0;
    requires \forall integer i, j; 0 <= i < n && 0 <= j < n ==> \separated(t[i], t[j]);
    requires \forall integer i; 0 <= i < n ==> t[i]->freq > 0;
    ensures Sorted(t, 0, n-1);
    assigns t[0..n-1];
 */
_Safe void insert_sort(struct Node *_Borrow _Nonnull t[_Nonnull ], int n) {
    int i = 1, j = 1;
    struct Node *_Borrow _Nonnull mv = t[0];

    /*@
        loop assigns i, j, mv;
        loop assigns t[0..n-1];
        loop variant n - i;
     */
    for (i = 1; i < n; i++) {
        mv = t[i];
        /*@
            loop assigns j, t[0..i];
            loop variant j;
         */
        for (j = i; j > 0; j--) {
            if (t[j - 1]->freq <= mv->freq) break;
            t[j] = t[j - 1];
        }
        t[j] = mv;
    }
}

/*@
  requires n > 0;
  requires \valid_read(arr+(0..(n - 1)));
  requires \forall integer i, j; 0 <= i < n && 0 <= j < n ==> \separated(arr[i], arr[j]);
  requires Sorted(arr, 0, n);
  requires \forall integer i; 0 <= i < n ==> arr[i]->freq > 0 && arr[i]->left == NULL && arr[i]->right == NULL;
  assigns arr[0..n-1];
  ensures \result != \null;
*/
_Safe struct Node *_Borrow _Nonnull _huffman(
    struct Node *_Borrow _Nonnull arr[_Nonnull ], int n) {
    int length = n;
    /*@
        loop assigns arr[0..n-1];
        loop variant length;
    */
    while (length > 1) {
        //@assert Sorted(arr, 0, length);
        struct Node *_Borrow _Nonnull node1 = arr[0];
        arr[0] = arr[length - 1];
        length -= 1;
        struct Node *_Borrow _Nonnull node2 = arr[1];
        struct Node *_Borrow _Nonnull merged =
            newNode('\0', node1->freq + node2->freq, node1, node2);
        arr[1] = merged;
        insert_sort(arr, length);
    }
    return arr[0];
}
