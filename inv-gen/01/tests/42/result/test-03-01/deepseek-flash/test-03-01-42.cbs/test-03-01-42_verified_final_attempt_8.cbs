#define MAX_VERTICES 100
#define INF 1000000000

/*@
  predicate matrix_bounded{L}(int (*m)[MAX_VERTICES], integer n) =
    \forall integer i, j;
      0 <= i < n && 0 <= j < n ==> 0 <= \at(m[i][j], L) <= INF;

  predicate diagonal_zero{L}(int (*m)[MAX_VERTICES], integer n) =
    \forall integer i; 0 <= i < n ==> \at(m[i][i], L) == 0;

  predicate no_larger_than_graph{G,D}(int (*graph)[MAX_VERTICES],
                                      int (*dist)[MAX_VERTICES],
                                      integer n) =
    \forall integer i, j;
      0 <= i < n && 0 <= j < n ==> \at(dist[i][j], D) <= \at(graph[i][j], G);

  predicate direct_two_hop_closed{G,D}(int (*graph)[MAX_VERTICES],
                                       int (*dist)[MAX_VERTICES],
                                       integer n) =
    \forall integer i, j, k;
      0 <= i < n && 0 <= j < n && 0 <= k < n &&
      \at(graph[i][k], G) < INF &&
      \at(graph[k][j], G) < INF
      ==> \at(dist[i][j], D) <= \at(graph[i][k], G) + \at(graph[k][j], G);

  predicate shortest_path_matrix{G,D}(int (*graph)[MAX_VERTICES],
                                      int (*dist)[MAX_VERTICES],
                                      integer n) =
    matrix_bounded{D}(dist, n) &&
    diagonal_zero{D}(dist, n) &&
    no_larger_than_graph{G,D}(graph, dist, n) &&
    direct_two_hop_closed{G,D}(graph, dist, n);
*/

/*@
  requires 1 <= n <= MAX_VERTICES;
  requires \valid_read(graph + (0 .. n - 1));
  requires \forall integer i; 0 <= i < n ==> \valid_read(graph[i] + (0 .. n - 1));
  requires \valid(dist + (0 .. n - 1));
  requires \forall integer i; 0 <= i < n ==> \valid(dist[i] + (0 .. n - 1));
  requires \separated(graph + (0 .. n - 1), dist + (0 .. n - 1));
  requires matrix_bounded{Pre}(graph, n);
  requires diagonal_zero{Pre}(graph, n);

  assigns dist[0 .. n - 1][0 .. n - 1];

  ensures shortest_path_matrix{Here,Here}(graph, dist, n);
*/
_Safe void floyd(int n, int graph[_Nonnull][MAX_VERTICES],
                 int dist[_Nonnull][MAX_VERTICES])
{
    int i;
    int j;
    int k;

      // Loop A
/*@
      loop invariant i_0: 0 <= i && i <= n;

      loop invariant i_1: \forall integer r, c; 0 <= r && r < i && 0 <= c && c < n ==> dist[r][c] == graph[r][c];


      loop assigns i, j, dist[0 .. n - 1][0 .. n - 1];
    */
    for (i = 0; i < n; i++) {
              // Loop B
/*@
          loop invariant i_7: 0 <= j && j <= n;

          loop invariant i_8: 0 <= i && i < n;

          loop invariant i_9: \forall integer c; 0 <= c < j ==> dist[i][c] == graph[i][c];

          loop invariant i_10: \forall integer r, c; 0 <= r < i && 0 <= c < n ==> dist[r][c] == graph[r][c];


          loop assigns j, dist[i][0 .. n - 1];
        */
        for (j = 0; j < n; j++) {
            dist[i][j] = graph[i][j];
        }
    }

      // Loop C
/*@
      loop invariant i_2: 0 <= k && k <= n;

      loop invariant i_3: matrix_bounded{Here}(dist, n);

      loop invariant i_4: diagonal_zero{Here}(dist, n);

      loop invariant i_5: no_larger_than_graph{Pre,Here}(graph, dist, n);

      loop invariant i_6: \forall integer i, j, m; 0 <= i < n && 0 <= j < n && 0 <= m < k && graph[i][m] < INF && graph[m][j] < INF ==> dist[i][j] <= graph[i][m] + graph[m][j];


      loop assigns k, i, j, dist[0 .. n - 1][0 .. n - 1];
    */
    for (k = 0; k < n; k++) {
              // Loop D
/*@
          loop invariant i_11: 0 <= i && i <= n;

          loop invariant i_12: 0 <= k && k < n;

          loop invariant i_13: matrix_bounded{Here}(dist, n);

          loop invariant i_14: diagonal_zero{Here}(dist, n);

          loop invariant i_15: no_larger_than_graph{Pre,Here}(graph, dist, n);

          loop invariant i_16: \forall integer a, b, m; 0 <= a < n && 0 <= b < n && 0 <= m < k && graph[a][m] < INF && graph[m][b] < INF ==> dist[a][b] <= graph[a][m] + graph[m][b];

          loop invariant i_17: \forall integer a, b; 0 <= a < i && 0 <= b < n && graph[a][k] < INF && graph[k][b] < INF ==> dist[a][b] <= graph[a][k] + graph[k][b];


          loop assigns i, j, dist[0 .. n - 1][0 .. n - 1];
        */
        for (i = 0; i < n; i++) {
                      // Loop E
/*@
              loop invariant i_18: 0 <= j && j <= n;

              loop invariant i_19: 0 <= i && i < n;

              loop invariant i_20: 0 <= k && k < n;

              loop invariant i_21: matrix_bounded{Here}(dist, n);

              loop invariant i_22: diagonal_zero{Here}(dist, n);

              loop invariant i_23: no_larger_than_graph{Pre,Here}(graph, dist, n);

              loop invariant i_24: \forall integer a, b, m; 0 <= a < n && 0 <= b < n && 0 <= m < k && graph[a][m] < INF && graph[m][b] < INF ==> dist[a][b] <= graph[a][m] + graph[m][b];

              loop invariant i_25: \forall integer a, b; 0 <= a < i && 0 <= b < n && graph[a][k] < INF && graph[k][b] < INF ==> dist[a][b] <= graph[a][k] + graph[k][b];

              loop invariant i_26: \forall integer c; 0 <= c < j && graph[i][k] < INF && graph[k][c] < INF ==> dist[i][c] <= graph[i][k] + graph[k][c];

              loop invariant i_27: \forall integer c; 0 <= c < n && c >= j ==> dist[i][c] == \at(dist[i][c], LoopEntry);

              loop invariant i_28: \forall integer r, c; 0 <= r < n && 0 <= c < n && r != i ==> dist[r][c] == \at(dist[r][c], LoopEntry);

              loop invariant i_29: \forall integer a, b, m; 0 <= a < n && 0 <= b < n && 0 <= m < k && graph[a][m] < INF && graph[m][b] < INF ==> \at(dist[a][b], LoopEntry) <= graph[a][m] + graph[m][b];

              loop invariant i_30: \forall integer a, b; 0 <= a < n && 0 <= b < n ==> graph[a][b] == \at(graph[a][b], Pre);

              loop invariant i_31: dist[i][k] <= graph[i][k];

              loop invariant i_33: \forall integer a,b; 0 <= a < n && 0 <= b < n ==> dist[a][b] <= \at(dist[a][b], LoopEntry);

              loop invariant i_34: \forall integer c; 0 <= c < n && graph[i][k] < INF && graph[k][c] < INF && (c < j || dist[i][k] + dist[k][c] >= dist[i][c]) ==> dist[i][c] <= graph[i][k] + graph[k][c];

              loop invariant i_35: \forall integer r, b, d; 0 <= r < n && r != i && 0 <= b < n && 0 <= d < n ==> &dist[r][b] != &dist[i][d];

              loop invariant i_36: \forall integer a, b, m; 0 <= a < n && 0 <= b < n && 0 <= m < k && \at(graph[a][m], LoopEntry) < INF && \at(graph[m][b], LoopEntry) < INF ==> \at(dist[a][b], LoopEntry) <= \at(graph[a][m], LoopEntry) + \at(graph[m][b], LoopEntry);

              loop invariant i_37: j < n ==> dist[k][j] <= graph[k][j];

              loop invariant i_38: \forall integer r, c1, c2; 0 <= r < n && 0 <= c1 < n && 0 <= c2 < n && c1 != c2 ==> &dist[r][c1] != &dist[r][c2];

              loop invariant i_40: \forall integer a, b, c; 0 <= a < i && 0 <= b < n && 0 <= c < n ==> &dist[a][b] != &dist[i][c];

              loop invariant i_41: \forall integer a, b, c, d; 0 <= a < n && 0 <= b < n && 0 <= c < n && 0 <= d < n ==> &graph[a][b] != &dist[c][d];


              loop assigns j, dist[i][0 .. n - 1];
            */
            for (j = 0; j < n; j++) {
                if (dist[i][k] < INF &&
                    dist[k][j] < INF &&
                    dist[i][k] + dist[k][j] < dist[i][j]) {
                    dist[i][j] = dist[i][k] + dist[k][j];
                }
            }
        }
    }
}
