#include <stddef.h>
#include <stdio.h>

struct Node {
    int key;
    struct Node *_Borrow _Nullable left;
    struct Node *_Borrow _Nullable right;
};

/*@
    predicate BST{L}(struct Node* t) =
        t == \null || (\valid(t) &&
        (t->left == \null || t->left->key <= t->key) &&
        (t->right == \null || t->right->key >= t->key) &&
        BST(t->left) && BST(t->right));

    logic integer height(struct Node* t) =
        t == \null ? 0 : 1 + \max(height(t->left), height(t->right));
*/

/*@
    requires BST(root);
    assigns \nothing;
    ensures \result == \null || \result->key == key;
*/
_Safe struct Node *_Borrow _Nullable _bst_search(
    struct Node *_Borrow _Nullable root, int key) {
    struct Node *_Borrow _Nullable cur = root;
        // Loop A
/*@
        loop invariant i_0: BST(cur);


        loop assigns cur;
    */
    while (cur != nullptr && cur->key != key) {
        if (key < cur->key)
            cur = cur->left;
        else
            cur = cur->right;
    }
    return cur;
}
