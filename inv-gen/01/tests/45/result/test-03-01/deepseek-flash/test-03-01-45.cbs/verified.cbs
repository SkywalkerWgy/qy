#define MAX 100

/*@
  axiomatic PrimeMath {
    predicate divides(integer d, integer x) =
      d != 0 && x % d == 0;

    predicate is_prime(integer x) =
      2 <= x &&
      (\forall integer d; 2 <= d && d * d <= x ==> !divides(d,x));

    axiom divides_square:
      \forall integer d; d != 0 ==> divides(d,d*d);

    axiom divides_plus:
      \forall integer d, x; 0 < d && divides(d,x) ==> divides(d,x+d);

    axiom close_multiples_equal:
      \forall integer d, a, b;
        0 < d && divides(d,a) && divides(d,b) && a <= b < a + d ==> a == b;
  }
*/

/* Sieve of Eratosthenes: returns all primes <= n.
   primes[] must have space for at least n entries. */
/*@
  requires 2 <= n <= 100;
  requires \valid(primes + (0..n-1));
  assigns primes[0..n-1];
  ensures 0 <= \result <= n - 1;
  ensures 1 <= \result;
  ensures primes[0] == 2;
  ensures \forall integer k; 0 <= k < \result ==> 2 <= primes[k] <= n;
  ensures \forall integer k; 0 <= k < \result ==> is_prime(primes[k]);
  ensures \forall integer a, b; 0 <= a < b < \result ==> primes[a] < primes[b];
*/
_Safe int sieve_eratosthenes(int n, int primes[_Nonnull]) {
    int is_p[MAX + 1];
    int i, p, cnt;

    /* initialize: all numbers >= 2 are candidates */
      // Loop A
/*@
      loop invariant i_0: 2 <= i && i <= n + 1;

      loop invariant i_1: \forall integer k; 2 <= k < i ==> is_p[k] == 1;


      loop assigns i, is_p[2..n];
      loop variant n - i + 1;
    */
    for (i = 2; i <= n; i++) is_p[i] = 1;

    cnt = 0;

    /* mark composites: for each prime p, mark p*p, p*(p+1), ... */
      // Loop B
/*@
      loop invariant i_11: 2 <= p && p <= n + 1;

      loop invariant i_12: \forall integer k; 2 <= k <= n ==> is_p[k] == 0 || is_p[k] == 1;

      loop invariant i_13: \forall integer k; 2 <= k <= n && is_prime(k) ==> is_p[k] == 1;

      loop invariant i_14: \forall integer k; 2 <= k <= n && k < p * p && is_p[k] == 1 ==> is_prime(k);

      loop invariant i_15: \forall integer k, d; 2 <= d && d < p && d * d <= k && k <= n && divides(d,k) ==> is_p[k] == 0;

      loop invariant i_24: \forall integer k; 2 <= k <= n && k < (p + 1) * (p + 1) && !is_prime(k) ==> \exists integer d; 2 <= d <= p && d * d <= k && divides(d, k);


      loop assigns p, i, is_p[2..n];
      loop variant n - p;
    */
    for (p = 2; p * p <= n; p++) {
              // Loop C
/*@
          loop invariant i_16: 2 <= p && p <= n;

          loop invariant i_17: p * p <= i && i <= n + p;

          loop invariant i_18: divides(p, i);

          loop invariant i_19: \forall integer k; 2 <= k <= n ==> is_p[k] == 0 || is_p[k] == 1;

          loop invariant i_20: \forall integer k; 2 <= k <= n && is_prime(k) ==> is_p[k] == 1;

          loop invariant i_21: \forall integer k; 2 <= k <= n && k < p * p && is_p[k] == 1 ==> is_prime(k);

          loop invariant i_22: \forall integer k, d; 2 <= d && d < p && d * d <= k && k <= n && divides(d,k) ==> is_p[k] == 0;

          loop invariant i_23: \forall integer k; p * p <= k && k < i && divides(p,k) ==> is_p[k] == 0;

          loop invariant i_25: \forall integer k; 2 <= k <= n && k < (p + 1) * (p + 1) && !is_prime(k) ==> \exists integer d; 2 <= d <= p && d * d <= k && divides(d, k);


          loop assigns i, is_p[p * p..n];
          loop variant n - i + 1;
        */
        for (i = p * p; i <= n; i += p) {
            is_p[i] = 0;
        }
    }
    /*@ assert is_p[2] == 1; */
    /*@ assert \forall integer k; 2 <= k <= n && is_p[k] == 1 ==> is_prime(k); */

    /* collect surviving primes */
      // Loop D
/*@
      loop invariant i_2: 2 <= i <= n + 1;

      loop invariant i_3: 0 <= cnt <= i - 2;

      loop invariant i_4: \forall integer k; 0 <= k < cnt ==> 2 <= primes[k] < i;

      loop invariant i_5: \forall integer k; 0 <= k < cnt ==> primes[k] <= n;

      loop invariant i_6: \forall integer k; 0 <= k < cnt ==> is_p[primes[k]] == 1;

      loop invariant i_7: \forall integer k; 0 <= k < cnt ==> is_prime(primes[k]);

      loop invariant i_8: \forall integer k; 2 <= k < i && is_p[k] == 1 ==> \exists integer j; 0 <= j < cnt && primes[j] == k;

      loop invariant i_9: \forall integer a, b; 0 <= a < b < cnt ==> primes[a] < primes[b];

      loop invariant i_10: i > 2 ==> 1 <= cnt && primes[0] == 2;


      loop assigns i, cnt, primes[0..n-1];
      loop variant n - i + 1;
    */
    for (i = 2; i <= n; i++) {
        if (is_p[i]) {
            /*@ assert is_prime(i); */
            /*@ assert \forall integer k; 0 <= k < cnt ==> primes[k] < i; */
            primes[cnt] = i;
            cnt = cnt + 1;
        }
        /*@ assert i != 2 || (1 <= cnt && primes[0] == 2); */
    }

    return cnt;
}
