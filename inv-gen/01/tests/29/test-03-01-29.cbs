/*@
    predicate string_same(char* t, char* p, integer n, integer m, integer match) =
        n < m || \forall integer k; 0 <= k < m ==> p[k] == t[match + k];
*/

/*@
    requires \valid_read(t);
    requires \valid_read(p);
    requires \valid(t + (0..n - 1));
    requires \valid(p + (0..m - 1));
    requires \separated(&t[0..(n - 1)], &p[0..(m - 1)]);
    requires n > 0;
    requires m > 0;
    assigns \nothing;
    ensures \result == 1 ==> string_same(t, p, n, m, match);
*/
_Safe int string_same_judge(char *_Nonnull t, char *_Nonnull p, int n, int m, int match){
    /*@
        loop assigns j;
    */
    for (int j = 0; j < m; j++){
        if (p[j] == t[match + j]) {
            continue;
        }
        else{
            return 0;
        }
    }
    return 1;
}

/*@
    requires \valid_read(t);
    requires \valid_read(p);
    requires \valid(t + (0..n - 1));
    requires \valid(p + (0..m - 1));
    requires \separated(&t[0..(n - 1)], &p[0..(m - 1)]);
    requires n > 0;
    requires m > 0;
    assigns \nothing;
    ensures \result == -1 || string_same(t, p, n, m, \result);
*/
_Safe int _naive_string_matcher(char *_Nonnull t, char *_Nonnull p, int m, int n) {
    if(n < m){
        return -1;
    }
    /*@
        loop assigns i;
    */
    for (int i = 0; i < n - m; i++){
        /*@
            loop assigns j;
        */
        for (int j = 0; j < m; j++){
            if(string_same_judge(t, p, n, m, j) == 1){
                return j;
            }
        }
    }
    return -1;
}
