/*@
    predicate increasing{L}(int * a, integer n) =\forall integer k; 0 <= k < n-1 ==> a[k] <= a[k+1];
*/

/*@
    predicate gapsort{L}(int* a, integer n, integer gap) =
        gap > 0 && gap <= n && \forall integer k; 0 <= k < n - gap ==> a[k] <= a[k + gap];
*/

/*@
    predicate subseq_sorted{L}(int * a, integer n, integer gap, integer start) =
        gap > 0 && 0 <= start < gap && start < n &&
        \forall integer k; 0 <= k && start + k*gap < n-gap ==> a[start+k*gap] <= a[start+k*gap+gap];
*/

/*@
    lemma subseq_sorted_gapsort{L}:
        \forall int *a, integer n, gap; n >= 0 && gap > 0 && \forall integer s; 0 <= s < gap ==> subseq_sorted{L}(a, n, gap,s) ==> gapsort{L}(a,n,gap);
*/

/*@
    lemma gapsort_increasing{L}:\forall int * a, integer n; gapsort{L}(a, n, 1) ==> increasing{L}(a, n);
*/

/*@
    requires \valid(x) && \valid(y);
    assigns *x, *y;
    ensures *x == \old(*y) && *y == \old(*x);
*/
_Safe void swap(int *_Borrow _Nonnull x, int *_Borrow _Nonnull y) {
    int tmp = *x;
    *x = *y;
    *y = tmp;
}

/*@
    requires \valid(arr+(0..(n - 1)));
    requires n > 0;
    assigns arr[0..(n - 1)];
    ensures e_1: increasing{Post}(arr, n);
*/
_Safe void _shell_sort(int arr[_Nonnull ], int n) {
        // Loop A
/*@
        loop invariant i_0: gap >= 0 && gap <= n;

        loop invariant i_1: gap == 0 ==> increasing(arr, n);


        loop assigns gap;
        loop assigns arr[0..(n - 1)];
    */
    for (int gap = n / 2; gap > 0; gap /= 2) {
                // Loop B
/*@
            loop invariant i_2: gap > 0 && gap <= n;

            loop invariant i_3: i >= gap && i <= n;

            loop invariant i_4: \forall integer s; 0 <= s < gap ==> subseq_sorted{Here}(arr, i, gap, s);


            loop assigns i;
            loop assigns arr[0..(n - 1)];
        */
        for (int i = gap; i < n; i++) {
                        // Loop C
/*@
                loop invariant i_5: -gap <= j && (i - j) % gap == 0;

                loop invariant i_6: \forall integer k; 0 <= k && k < j && (i - k) % gap == 0 ==> arr[k] <= arr[k+gap];

                loop invariant i_7: \forall integer k; j + gap <= k && k < i && (i - k) % gap == 0 ==> arr[k] <= arr[k+gap];


                loop assigns j;
                loop assigns arr[0..(n - 1)];
            */
            for (int j = i - gap; j >= 0 && arr[j] > arr[j+gap]; j -= gap) {
                int tmp = arr[j];
                arr[j] = arr[j + gap];
                arr[j + gap] = tmp;
            }
        }
    }
}
