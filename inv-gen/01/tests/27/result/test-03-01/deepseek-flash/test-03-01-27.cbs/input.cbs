/*@ axiomatic PowMod {
    logic integer pow_mod(integer x, integer n, integer m);

    axiom pow_0: \forall integer x, m; m > 0 ==> pow_mod(x, 0, m) == 1 ;

    axiom pow_range: \forall integer x, n, m;
        m > 0 && x >= 0 && n >= 0 ==> 0 <= pow_mod(x, n, m) < m;

    axiom pow_base_mod: \forall integer x, n, m;
        m > 0 ==> pow_mod(x, n, m) == pow_mod(x % m, n, m);

    axiom pow_succ: \forall integer x, n, m;
        m > 0 && n > 0 ==>
        pow_mod(x, n, m) == ((x % m) * pow_mod(x, n - 1, m)) % m;
    }
 */

/*@
    lemma pow_loop_even: \forall integer r, b, e, m;
        m > 0 && e > 0 && e % 2 == 0 ==>
        (r * pow_mod(b, e, m)) % m ==
        (r * pow_mod((b * b) % m, e / 2, m)) % m;

    lemma pow_loop_odd: \forall integer r, b, e, m;
        m > 0 && e % 2 == 1 ==>
        (r * pow_mod(b, e, m)) % m ==
        ((r * b % m) * pow_mod((b * b) % m, e / 2, m)) % m;
 */

/*@
    requires m > 0;
    requires x >= 0;
    requires n >= 0;
    assigns \nothing;
    ensures 0 <= \result < m;
    ensures \result == pow_mod(x, n, m);
*/
_Safe int fast_pow_mod(int x, int n, int m) {
    int res = 1 % m;
    int base = x % m;
    int exp = n;

    /*@
        loop assigns res, base, exp;
    */
    while (exp > 0) {
        if (exp % 2 == 1) {
            res = (res * base) % m;
            base = (base * base) % m;
            exp = exp / 2;
        }
        else {
            base = (base * base) % m;
            exp = exp / 2;
        }
    }
    return res;
}

/*@
    lemma non_trivial_root: \forall integer x, n;
        n > 2 && 1 < x < n - 1 && (x * x) % n == 1 ==>
        \exists integer d; 1 < d < n && n % d == 0;
 */

/*@
    requires n > 2 && n % 2 == 1;
    requires 2 <= a < n;
    requires d > 0 && s >= 0;
    assigns \nothing;
    ensures \result == 0 || \result == 1;
    ensures \result == 0 ==> \exists integer d; 1 < d < n && n % d == 0;
*/
_Safe int miller_rabin_witness(int n, int a, int d, int s) {
    int x = fast_pow_mod(a, d, n);

    if (x == 1 || x == n - 1) return 1;

    /*@
        loop assigns i, x;
    */
    for (int i = 0; i < s - 1; i++) {
        int prev = x;
        x = (x * x) % n;
        if (x == n - 1) return 1;
        if (x == 1) {
            //@ assert prev * prev % n == 1;
            //@ assert 1 < prev < n - 1;
            return 0;
        }
    }

    return 1;
}

/*@
    requires n > 2 && n % 2 == 1;
    assigns \nothing;
    ensures \result == 0 || \result == 1;
*/
_Safe int miller_rabin(int n) {
    int d = n - 1;
    int s = 0;

    /*@
        loop assigns d, s;
    */
    while (d % 2 == 0) {
        d = d / 2;
        s = s + 1;
    }

    int a;
    /*@
        loop assigns a;
    */
    for (a = 2; a < n && a < 8; a++) {
        if (miller_rabin_witness(n, a, d, s) == 0) return 0;
    }

    return 1;
}
